{
  "name": "dailylift",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo -F web dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "start": "npm run start -w web"
  },
  "devDependencies": {
    "@dailylift/config": "*",
    "@types/node": "^22.16.5",
    "turbo": "^2.10.7",
    "typescript": "^5.8.3"
  },
  "packageManager": "npm@10.9.4"
}
