# --- Supabase (client) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# This web app's own origin — used to build OAuth/email redirect callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (server-only) ---
# Service-role (secret) key for privileged operations (e.g. seeding the
# exercise library). Never expose to the browser — no NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# --- AI plan generation (server-only) ---
# Used by the /api/generate-plan and /api/suggest-split route handlers to
# call the Google Gemini API.
GEMINI_API_KEY=
