# --- Supabase (client) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# This web app's own origin — used to build OAuth/email redirect callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI plan generation (server-only) ---
# Used by the /api/generate-plan route handler to call the Anthropic API.
ANTHROPIC_API_KEY=
